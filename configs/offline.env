# Source AFTER configs/pod.env, from the project root on the offline pod.
export HF_HUB_CACHE="$PWD/data/offline_models/hub"
export HUGGINGFACE_HUB_CACHE="$HF_HUB_CACHE"
export SENTENCE_TRANSFORMERS_HOME="$HF_HUB_CACHE"
unset TRANSFORMERS_CACHE
export U2NET_HOME="$PWD/data/offline_models/u2net"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_HUB_DISABLE_TELEMETRY=1
