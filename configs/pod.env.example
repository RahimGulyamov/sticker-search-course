# Copy to configs/pod.env and set your own values. Do not put tokens here.
export YT_PROXY="${YT_PROXY:-YOUR_YT_PROXY}"
export STICKER_YT_ROOT="${STICKER_YT_ROOT:-//home/USER/cv_project}"
export STICKER_YT_DIR="${STICKER_YT_DIR:-$STICKER_YT_ROOT/datasets/v1}"
export STICKER_CATALOG="${STICKER_CATALOG:-data/catalog}"
export STICKER_GPU_WORKERS="${STICKER_GPU_WORKERS:-4}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export HF_HOME="${HF_HOME:-$PWD/.cache/huggingface}"
export U2NET_HOME="${U2NET_HOME:-$PWD/.cache/u2net}"
